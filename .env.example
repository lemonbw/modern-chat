# GREEN-API credentials, used only by the server.
# Do NOT prefix them with VITE_: Vite inlines every VITE_ variable into the browser bundle,
# which would expose the instance token to anyone who opens the page.
GREEN_API_URL=https://api.green-api.com
GREEN_API_INSTANCE=1100000000
GREEN_API_TOKEN=your-token-here

# Password of the app itself. Without it /api/auth answers 500 and the proxy stays closed.
APP_PASSWORD=choose-a-long-password

# Password for the mutating calls (sending, deleting, contacts, logout). Defaults to APP_PASSWORD.
# WRITE_PASSWORD=another-long-password

# Key that signs the session cookies. Generated per deployment, rotated by redeploying.
# Without it the key is derived from APP_PASSWORD.
# SESSION_SECRET=random-string

# false turns the deployment into read only mode: sending and deleting are refused server side.
APP_ALLOW_WRITES=true