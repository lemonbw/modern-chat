{
  "name": "modern-chat",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "build:server": "esbuild api/greenapi/[method].ts --bundle --platform=node --format=esm --outfile=dist-server/greenapi.mjs && esbuild api/auth.ts --bundle --platform=node --format=esm --outfile=dist-server/auth.mjs && esbuild api/og.ts --bundle --platform=node --format=esm --outfile=dist-server/og.mjs",
    "build:all": "pnpm run build && pnpm run build:server",
    "start": "node server.js",
    "docker:build": "docker build --network=host -t modern-chat .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env.local modern-chat"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "5.4.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "16.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "3.2.4"
  }
}
